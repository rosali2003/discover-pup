# Mapbox tokens - get these from https://account.mapbox.com/
# Copy this file to .env and fill in your tokens
#
# Public token (pk.*) - safe to use in client code
MAPBOX_PUBLIC_TOKEN=pk.your_public_token_here

# Secret token (sk.*) - used for downloading SDK during build
MAPBOX_SECRET_TOKEN=sk.your_secret_token_here

